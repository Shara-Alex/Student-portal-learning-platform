# Copy to .env and edit. Never commit .env.
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Leave DB_HOST empty to use a local SQLite file (quick dev). Set it to use Postgres.
DB_HOST=
DB_NAME=school
DB_USER=school
DB_PASSWORD=school
DB_PORT=5432

# Copy to .env and edit. Never commit .env.
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Leave DB_HOST empty to use a local SQLite file (quick dev). Set it to use Postgres.
DB_HOST=
DB_NAME=school
DB_USER=school
DB_PASSWORD=school
DB_PORT=5432

# Email. Leave EMAIL_HOST empty and emails are printed in the server terminal instead of sent.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=School <no-reply@example.com>

# 1 = send small batches of notification emails straight away. 0 = only the send_notifications command sends.
NOTIFICATIONS_SEND_NOW=1

# Address of the frontend, used for links inside emails (password reset).
FRONTEND_URL=http://localhost:5173

# Where app.log is written. Empty = backend/logs/
LOG_DIR=
